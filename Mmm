    b.Text = ""; b.AutoButtonColor = false
    Instance.new("UICorner", b).CornerRadius = UDim.new(1, 0)
    local k = Instance.new("Frame", b)
    k.Size = UDim2.fromOffset(14, 14); k.BackgroundColor3 = Color3.new(1, 1, 1)
    Instance.new("UICorner", k).CornerRadius = UDim.new(1, 0)
    local st = default
    local function render()
        b.BackgroundColor3 = st and Color3.fromRGB(220, 40, 50) or Color3.fromRGB(50, 50, 55)
        k.Position = st and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
    end
    render()
    b.MouseButton1Click:Connect(function()
        st = not st; render(); if cb then cb(st) end
    end)
    return { get = function() return st end, set = function(v) st = v; render(); if cb then cb(v) end end }
end

