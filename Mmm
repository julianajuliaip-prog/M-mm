-- ── field-egg scan ─────────────────────────────────────────────
local function findFieldEgg(maxDist)
    if not (Egg and Egg.ReadOwnerEggs) then return nil end
    local pos = hrp() and hrp().Position; if not pos then return nil end
    local ok, records = pcall(Egg.ReadOwnerEggs, Egg, LP.UserId)
    if not ok or type(records) ~= "table" then return nil end
    local best, bestD
    for k, rec in pairs(records) do
        if type(rec) == "table" and rec.BottomCFrame then
            local uid = rec.Uid or k
            local isField = type(uid) == "string" and uid:sub(1, 13) == "FirstAreaEgg_"
            local st = rec.State
            if isField and (st == nil or st == "Slot" or st == "Dropped") then
                local p = rec.BottomCFrame.Position
                local d = Vector3.new(p.X - pos.X, 0, p.Z - pos.Z).Magnitude
                if d <= (maxDist or 600) and (not bestD or d < bestD) then
                    bestD, best = d, { uid = uid, at = p, rec = rec }
                end
            end
        end
    end
    return best
end

local function findGuard(areaId)
    local world = WS:FindFirstChild("World") or WS:FindFirstChild("__OBJECTS")
    local g = world and world:FindFirstChild("Areas")
    g = g and g:FindFirstChild("GuardAreas")
    g = g and g:FindFirstChild(tostring(areaId or "Forest"))
    g = g and g:FindFirstChild("Guard")
    return g and g:FindFirstChild("HumanoidRootPart", true)
end

-- ── steal ──────────────────────────────────────────────────────
local function stealEgg(egg)
    local guard = findGuard(egg.rec and egg.rec.AreaId or "Forest")
    if not guard then return false, "no guard" end
    if not ForestStrike then return false, "no strike remote" end
    local root = hrp(); if not root then return false, "no root" end
    root.CFrame = CFrame.new(egg.at + Vector3.new(0, 3, 0))
    task.wait(0.2)
    ForestStrike:FireServer({ EggUid = egg.uid, GuardCFrame = guard.CFrame })
    return true
end

local stealingBusy = false
local function startStealLoop()
    if stealingBusy then return end
    stealingBusy = true
    task.spawn(function()
        while state.autoSteal do
            if not alive() then task.wait(0.5) end
            local egg = findFieldEgg(600)
            if egg then
                state.status = "stealing " .. egg.uid:sub(-12)
                local ok, err = stealEgg(egg)
                if not ok then state.status = "fail: " .. err end
                task.wait(1.2)
            else
                state.status = "no egg in range"
                task.wait(0.8)
            end
        end
        stealingBusy = false
        state.status = "idle"
    end)
end

-- ── auto place ─────────────────────────────────────────────────
local function startPlaceLoop()
    task.spawn(function()
        while state.autoPlace do
            if state.carry.on then
                local ok, p = pcall(function()
                    return Plot and Plot.ResolvePlot and Plot.ResolvePlot()
                end)
                if ok and p and p.PlotFolder then
                    local root = hrp()
                    if root then
                        local pivot = p.PlotFolder:GetPivot()
                        root.CFrame = pivot + Vector3.new(0, 5, 0)
                    end
                end
                task.wait(1)
            else
                task.wait(0.4)
            end
        end
    end)
end

-- ── treadmill boost ────────────────────────────────────────────
local function startTreadmillLoop()
    task.spawn(function()
        while state.treadmill do
            local h = hum()
            if h and state.treadmill then
                h.WalkSpeed = 120
            end
            task.wait(0.5)
        end
        local h = hum(); if h then h.WalkSpeed = 16 end
    end)
end

-- ── webhook ────────────────────────────────────────────────────
local function log(text)
    if state.webhook == "" then return end
    pcall(function()
        request({
            Url = state.webhook,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpS:JSONEncode({ content = text }),
        })
    end)
end

