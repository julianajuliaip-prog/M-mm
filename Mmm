    if os.clock() - espDebounce < 0.4 then return end
    espDebounce = os.clock()
    for _, v in ipairs(tracked) do pcall(function() v:Destroy() end) end
    tracked = {}
    if not state.esp then return end
    for _, obj in ipairs(WS:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name:find("[Ee]gg")) then
            local bb = Instance.new("BillboardGui")
            bb.Adornee = obj; bb.Size = UDim2.fromOffset(90, 24)
            bb.AlwaysOnTop = true; bb.Parent = espFolder
            local l = Instance.new("TextLabel", bb)
            l.Size = UDim2.fromScale(1, 1); l.BackgroundTransparency = 1
            l.Font = Enum.Font.GothamBold; l.TextSize = 11
            l.TextColor3 = Color3.fromRGB(255, 240, 240); l.TextStrokeTransparency = 0
            l.Text = obj.Name
            tracked[#tracked + 1] = bb
        end
    end
end)

