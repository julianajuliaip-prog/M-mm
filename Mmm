local function fire(name, ...)
    local r = Networking:FindFirstChild(name); if not r then return end
    pcall(r.FireServer, r, ...)
end
local function invoke(name, ...)
    local r = Networking:FindFirstChild(name); if not r then return nil end
    local ok, a, b = pcall(r.InvokeServer, r, ...)
    return ok and a or nil, b
end

-- ── module loader ──────────────────────────────────────────────
local function req(path)
    local cur = RS
    for seg in path:gmatch("[^.]+") do cur = cur and cur:FindFirstChild(seg) end
    if not cur then return nil end
    local ok, m = pcall(require, cur); return ok and m or nil
end
